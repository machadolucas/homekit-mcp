<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent for the HomeKit MCP server. Rendered by deploy/install.sh
  (@HOME@ and @PORT@ are substituted). Must be a *user* LaunchAgent: the
  HomeKit framework needs the logged-in GUI session and the user's iCloud
  Home data. No secrets belong in this file.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.local.homekit-mcp</string>
    <!--
      Launched through LaunchServices (`open`), not by exec'ing the binary:
      a Mac Catalyst app started directly by launchd aborts with
      "_mainSceneIdentifier should have been set by now!". `-W` keeps `open`
      alive until the app quits, so KeepAlive restarts it; `-n` would allow
      duplicates, so it is deliberately absent. stdout/stderr and the port are
      handed to the app by `open` itself.
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/open</string>
        <string>-W</string>
        <string>-g</string>
        <string>--env</string>
        <string>HOMEKIT_MCP_PORT=@PORT@</string>
        <string>--stdout</string>
        <string>@HOME@/Library/Logs/homekit-mcp.log</string>
        <string>--stderr</string>
        <string>@HOME@/Library/Logs/homekit-mcp.log</string>
        <string>@HOME@/Applications/HomeKitMCP.app</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>@HOME@/Library/Logs/homekit-mcp.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>@HOME@/Library/Logs/homekit-mcp.launchd.log</string>
</dict>
</plist>
